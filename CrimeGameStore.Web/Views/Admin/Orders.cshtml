@using CrimeGameStore.Web.Models
@model IEnumerable<Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "إدارة الطلبات";
    OrderStatus? current = ViewBag.CurrentStatus;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h4 fw-bold text-poirot mb-0">إدارة طلبات العملاء</h1>
    <div class="btn-group btn-group-sm">
        <a asp-action="Orders" class="btn @(current == null ? "btn-poirot" : "btn-outline-secondary")">الكل</a>
        <a asp-action="Orders" asp-route-status="@OrderStatus.Pending" class="btn @(current == OrderStatus.Pending ? "btn-poirot" : "btn-outline-secondary")">جديد</a>
        <a asp-action="Orders" asp-route-status="@OrderStatus.Confirmed" class="btn @(current == OrderStatus.Confirmed ? "btn-poirot" : "btn-outline-secondary")">مؤكد</a>
        <a asp-action="Orders" asp-route-status="@OrderStatus.Shipped" class="btn @(current == OrderStatus.Shipped ? "btn-poirot" : "btn-outline-secondary")">قيد التوصيل</a>
        <a asp-action="Orders" asp-route-status="@OrderStatus.Completed" class="btn @(current == OrderStatus.Completed ? "btn-poirot" : "btn-outline-secondary")">مكتمل</a>
        <a asp-action="Orders" asp-route-status="@OrderStatus.Cancelled" class="btn @(current == OrderStatus.Cancelled ? "btn-poirot" : "btn-outline-secondary")">ملغي</a>
    </div>
</div>

<div class="admin-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>رقم الطلب</th>
                    <th>المشتري</th>
                    <th>الهاتف / المدينة</th>
                    <th>الدفع (شام كاش)</th>
                    <th>المبلغ</th>
                    <th>الحالة</th>
                    <th>التاريخ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var syp = o.Items.Where(i => i.Edition == EditionType.Physical).Sum(i => i.UnitPrice * i.Quantity);
                    var usd = o.Items.Where(i => i.Edition == EditionType.Digital).Sum(i => i.UnitPrice * i.Quantity);

                    <tr>
                        <td class="fw-bold" dir="ltr">@o.OrderNumber</td>
                        <td>@o.CustomerName</td>
                        <td>
                            <div dir="ltr">@o.PhoneNumber</div>
                            <small class="text-muted">@(o.City ?? "طلب رقمي فقط")</small>
                        </td>
                        <td>
                            <div>@(o.PaymentMethod == PaymentMethod.ShamCashDepositAndCod ? "رعبون شام كاش + عند الاستلام" : "دفع كامل شام كاش")</div>
                            @if (!string.IsNullOrWhiteSpace(o.PaymentReference))
                            {
                                <small class="text-poirot fw-bold">مرجع: @o.PaymentReference</small>
                            }
                        </td>
                        <td class="fw-bold">
                            @if (syp > 0)
                            {
                                <div class="text-poirot">@syp.ToString("N0") ل.س</div>
                            }
                            @if (usd > 0)
                            {
                                <div class="text-dark">@usd.ToString("0.##") $</div>
                            }
                        </td>
                        <td><span class="badge bg-dark">@o.Status</span></td>
                        <td dir="ltr">@o.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a asp-action="OrderDetails" asp-route-id="@o.Id" class="btn btn-sm btn-poirot">تفاصيل وتحديث</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>