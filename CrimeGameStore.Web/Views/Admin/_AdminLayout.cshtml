<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] | لوحة تحكم بوارو</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
            color: #111827;
        }

        .admin-nav {
            background-color: #0b2d56;
            border-bottom: 3px solid #111827;
        }

            .admin-nav .nav-link {
                color: rgba(255,255,255,0.85);
                font-weight: 600;
                border-radius: 6px;
                padding: 0.45rem 0.9rem;
            }

                .admin-nav .nav-link:hover, .admin-nav .nav-link.active {
                    color: #fff;
                    background-color: rgba(255,255,255,0.14);
                }

        .admin-card {
            background: #fff;
            border: 1px solid #dbe3ed;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(11,45,86,0.04);
        }

        .btn-poirot {
            background-color: #0b2d56;
            color: #fff;
            font-weight: 700;
        }

            .btn-poirot:hover {
                background-color: #071f3d;
                color: #fff;
            }

        .text-poirot {
            color: #0b2d56;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark admin-nav py-2 sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-shield-halved"></i> لوحة إدارة بوارو
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminMenu">
                <ul class="navbar-nav me-auto gap-1 mt-2 mt-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-chart-line ms-1"></i> الرئيسية</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Cases"><i class="fa-solid fa-folder-open ms-1"></i> القضايا</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Orders"><i class="fa-solid fa-box ms-1"></i> الطلبات</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Settings"><i class="fa-solid fa-sliders ms-1"></i> إعدادات ومحتوى الموقع</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Faqs"><i class="fa-solid fa-circle-question ms-1"></i> الأسئلة الشائعة</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                    <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-light">
                        <i class="fa-solid fa-up-right-from-square ms-1"></i> معاينة الموقع
                    </a>
                    <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fa-solid fa-right-from-bracket ms-1"></i> خروج
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-lg-4 py-4 flex-grow-1">
        @if (TempData["AdminSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0">
                <i class="fa-solid fa-circle-check ms-1"></i> @TempData["AdminSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["AdminError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0">
                <i class="fa-solid fa-triangle-exclamation ms-1"></i> @TempData["AdminError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>