@using CrimeGameStore.Web.Models
@model CrimeGameStore.Web.Models.CartViewModel

@{
    ViewData["Title"] = "حقيبة القضايا";
    ViewData["MetaDescription"] = "راجع القضايا المختارة في حقيبة بوارو وأتمم طلبك بنسخة ورقية أو إلكترونية.";

    var totalSyp = Model.Items.Where(i => i.Edition == EditionType.Physical).Sum(i => i.LineTotal);
    var totalUsd = Model.Items.Where(i => i.Edition == EditionType.Digital).Sum(i => i.LineTotal);
}

<section class="poirot-page-header py-4">
    <div class="container text-center">
        <h1 class="h3 fw-bold text-white mb-1">
            <i class="fa-solid fa-briefcase ms-2"></i> حقيبة القضايا
        </h1>
        <p class="small text-light opacity-75 mb-0">راجع ملفاتك المختارة قبل الانتقال إلى تأكيد الطلب</p>
    </div>
</section>

<section class="py-5 container">
    @if (TempData["CartSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check ms-1"></i> @TempData["CartSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation ms-1"></i> @TempData["CartError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="case-card p-5 text-center mx-auto" style="max-width: 600px;">
            <i class="fa-solid fa-briefcase fs-1 text-poirot-blue opacity-25 mb-3"></i>
            <h2 class="h4 fw-bold text-poirot-blue mb-2">حقيبة التحقيق فارغة حالياً</h2>
            <p class="text-muted small mb-4">لم تضف أي ملف قضية بعد. تصفح أرشيف بوارو واختر قضيتك الأولى!</p>
            <a asp-controller="Cases" asp-action="Index" class="btn btn-poirot-blue px-4">
                <i class="fa-solid fa-folder-open ms-1"></i> تصفح ملفات القضايا
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">
            <!-- قائمة القضايا داخل الحقيبة -->
            <div class="col-lg-8">
                <div class="case-card p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <h2 class="h5 fw-bold text-poirot-blue mb-0">الملفات المختارة (@Model.TotalItemsCount)</h2>
                        <form asp-controller="Cart" asp-action="Clear" method="post" onsubmit="return confirm('هل تريد إفراغ حقيبة القضايا بالكامل؟');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa-regular fa-trash-can ms-1"></i> إفراغ الحقيبة
                            </button>
                        </form>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model.Items)
                        {
                            var unitPriceText = item.Edition == EditionType.Physical
                            ? $"{item.UnitPrice:N0} ل.س"
                            : $"{item.UnitPrice:0.##} $";
                            var lineTotalText = item.Edition == EditionType.Physical
                            ? $"{item.LineTotal:N0} ل.س"
                            : $"{item.LineTotal:0.##} $";

                            <div class="cart-item-row p-3 rounded-3 border bg-light bg-opacity-50 d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                                <img src="@item.CoverImageUrl" alt="@item.Title" class="bg-white rounded border p-1" style="width: 78px; height: 78px; object-fit: contain;" />

                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        <span class="badge bg-poirot-black text-white" style="font-size: 0.72rem;">@item.CaseCode</span>
                                        @if (item.Edition == EditionType.Physical)
                                        {
                                            <span class="badge bg-poirot-blue text-white" style="font-size: 0.72rem;">
                                                <i class="fa-solid fa-box-open ms-1"></i> نسخة ورقية (شحن)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white" style="font-size: 0.72rem;">
                                                <i class="fa-solid fa-file-pdf ms-1"></i> نسخة إلكترونية (PDF)
                                            </span>
                                        }
                                    </div>
                                    <h3 class="h6 fw-bold mb-1">
                                        <a asp-controller="Cases" asp-action="Details" asp-route-slug="@item.Slug" class="text-dark">@item.Title</a>
                                    </h3>
                                    <div class="small text-muted">سعر الوحدة: <strong class="text-poirot-blue">@unitPriceText</strong></div>
                                </div>

                                <!-- التحكم بالكمية -->
                                <div class="d-flex align-items-center justify-content-between justify-content-sm-end gap-3">
                                    @if (item.Edition == EditionType.Physical)
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post">
                                                <input type="hidden" name="caseId" value="@item.CrimeCaseId" />
                                                <input type="hidden" name="edition" value="@((int)item.Edition)" />
                                                <input type="hidden" name="delta" value="-1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2">-</button>
                                            </form>
                                            <span class="px-2 fw-bold">@item.Quantity</span>
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post">
                                                <input type="hidden" name="caseId" value="@item.CrimeCaseId" />
                                                <input type="hidden" name="edition" value="@((int)item.Edition)" />
                                                <input type="hidden" name="delta" value="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2">+</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">نسخة واحدة</span>
                                    }

                                    <div class="text-start" style="min-width: 95px;">
                                        <strong class="text-poirot-blue">@lineTotalText</strong>
                                    </div>

                                    <form asp-controller="Cart" asp-action="Remove" method="post">
                                        <input type="hidden" name="caseId" value="@item.CrimeCaseId" />
                                        <input type="hidden" name="edition" value="@((int)item.Edition)" />
                                        <button type="submit" class="btn btn-sm text-danger border-0" title="حذف من الحقيبة">
                                            <i class="fa-solid fa-xmark fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ملخص الفاتورة -->
            <div class="col-lg-4">
                <div class="case-card p-4">
                    <h2 class="h5 fw-bold text-poirot-blue border-bottom pb-3 mb-3">ملخص الطلب</h2>

                    <div class="d-flex justify-content-between small mb-2">
                        <span class="text-muted">عدد الملفات:</span>
                        <strong class="text-dark">@Model.TotalItemsCount</strong>
                    </div>

                    <div class="d-flex justify-content-between small mb-3">
                        <span class="text-muted">طريقة الاستلام:</span>
                        <strong class="text-dark">
                            @if (Model.HasPhysicalItems && Model.HasDigitalItems)
                            {
                                <span>شحن ورقي + إرسال رقمي</span>
                            }
                            else if (Model.HasPhysicalItems)
                            {
                                <span>شحن وتوصيل للمنزل</span>
                            }
                            else
                            {
                                <span class="text-success">استلام إلكتروني فوري</span>
                            }
                        </strong>
                    </div>

                    <div class="border-top pt-3 mb-4">
                        <div class="fw-bold text-dark mb-2">الإجمالي المطلوب:</div>
                        @if (totalSyp > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">النسخ الورقية:</span>
                                <span class="h5 fw-bold text-poirot-blue mb-0">@totalSyp.ToString("N0") ل.س</span>
                            </div>
                        }
                        @if (totalUsd > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">النسخ الإلكترونية:</span>
                                <span class="h5 fw-bold text-dark mb-0">@totalUsd.ToString("0.##") $</span>
                            </div>
                        }
                    </div>

                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-poirot-blue btn-lg w-100 mb-2">
                        إتمام الطلب الآن <i class="fa-solid fa-arrow-left me-1"></i>
                    </a>
                    <a asp-controller="Cases" asp-action="Index" class="btn btn-poirot-outline w-100">
                        إضافة قضايا أخرى
                    </a>
                </div>
            </div>
        </div>
    }
</section>