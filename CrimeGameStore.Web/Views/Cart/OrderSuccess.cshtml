@using CrimeGameStore.Web.Models
@model CrimeGameStore.Web.Models.Order
@inject CrimeGameStore.Web.Services.ISiteSettingsService SettingsService

@{
    var settings = await SettingsService.GetSettingsAsync();
    ViewData["Title"] = "تم استلام طلبك بنجاح";
    bool hasPhysical = Model.Items.Any(i => i.Edition == EditionType.Physical);

    var totalSyp = Model.Items.Where(i => i.Edition == EditionType.Physical).Sum(i => i.UnitPrice * i.Quantity);
    var totalUsd = Model.Items.Where(i => i.Edition == EditionType.Digital).Sum(i => i.UnitPrice * i.Quantity);

    var totalParts = new List<string>();
    if (totalSyp > 0) totalParts.Add($"{totalSyp:N0} ل.س");
    if (totalUsd > 0) totalParts.Add($"{totalUsd:0.##} $");
    var totalText = totalParts.Any() ? string.Join(" + ", totalParts) : $"{Model.TotalAmount:0.##}";

    var waNumber = settings.WhatsAppNumber ?? "";
    var payText = Model.PaymentMethod == PaymentMethod.ShamCashDepositAndCod
        ? "رعبون شام كاش + الباقي عند الاستلام"
        : "دفع كامل عبر شام كاش";

    var waMsg = $"مرحباً {settings.SiteName}، قمت بتأكيد الطلب رقم {Model.OrderNumber} باسم {Model.CustomerName} بقيمة ({totalText}) - ({payText}). سأرسل لكم إشعار تحويل شام كاش لتثبيت الطلب.";
    var waUrl = $"https://wa.me/{waNumber}?text={Uri.EscapeDataString(waMsg)}";
}

<section class="py-5 container">
    <div class="case-card p-4 p-md-5 mx-auto" style="max-width: 720px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-poirot-blue text-white mb-3 shadow" style="width: 74px; height: 74px;">
                <i class="fa-solid fa-check fs-2"></i>
            </div>
            <h1 class="h3 fw-bold text-poirot-blue mb-2">تم تسجيل طلبك بنجاح في أرشيف @settings.SiteName!</h1>
            <p class="text-muted mb-3">شكراً لك يا <strong>@Model.CustomerName</strong>، سنتواصل معك قريباً على الرقم <strong dir="ltr">@Model.PhoneNumber</strong>.</p>
            <div class="d-inline-block bg-light border border-2 border-primary-subtle rounded-3 px-4 py-2">
                <small class="text-muted d-block">رقم الطلب المرجعي</small>
                <strong class="fs-5 text-poirot-blue" dir="ltr">@Model.OrderNumber</strong>
            </div>
        </div>

        <div class="border-top border-bottom py-3 my-4">
            <h2 class="h6 fw-bold text-poirot-blue mb-3">تفاصيل القضايا المطلوبة:</h2>
            @foreach (var item in Model.Items)
            {
                var lineText = item.Edition == EditionType.Physical
                ? $"{(item.UnitPrice * item.Quantity):N0} ل.س"
                : $"{(item.UnitPrice * item.Quantity):0.##} $";

                <div class="d-flex justify-content-between align-items-center small mb-2">
                    <div>
                        <strong>@(item.CrimeCase?.Title ?? "قضية")</strong>
                        <span class="badge @(item.Edition == EditionType.Physical ? "bg-poirot-blue" : "bg-secondary") me-1">
                            @(item.Edition == EditionType.Physical ? "ورقية" : "إلكترونية PDF")
                        </span>
                        <span class="text-muted">× @item.Quantity</span>
                    </div>
                    <strong class="text-dark">@lineText</strong>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center small border-top pt-3 mt-3">
                <span class="text-muted">طريقة الدفع:</span>
                <strong class="text-dark">@payText</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.PaymentReference))
            {
                <div class="d-flex justify-content-between align-items-center small mt-2">
                    <span class="text-muted">مرجع تحويل شام كاش:</span>
                    <strong class="text-poirot-blue">@Model.PaymentReference</strong>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                <span class="fw-bold">الإجمالي الكلي:</span>
                <strong class="fs-5 text-poirot-blue">@totalText</strong>
            </div>
        </div>

        @if (hasPhysical && !string.IsNullOrWhiteSpace(Model.ShippingAddress))
        {
            <div class="bg-light rounded-3 p-3 small mb-4">
                <div class="fw-bold text-poirot-blue mb-1"><i class="fa-solid fa-location-dot ms-1"></i> عنوان التوصيل المسجل:</div>
                <div class="text-muted">@Model.City — @Model.ShippingAddress</div>
            </div>
        }

        <!-- صندوق التأكيد الفوري عبر واتساب -->
        <div class="alert bg-poirot-blue text-white border-0 rounded-3 p-3 mb-4 text-center">
            <div class="fw-bold mb-2">
                <i class="fa-brands fa-whatsapp fs-5 ms-1"></i> الخطوة الأخيرة لتثبيت طلبك بسرعة:
            </div>
            <p class="small opacity-75 mb-3">
                أرسل لنا إشعار تحويل <strong>شام كاش</strong> عبر واتساب مع رقم طلبك <strong>@Model.OrderNumber</strong> للبدء فوراً بالشحن أو إرسال الملفات.
            </p>
            <a href="@waUrl" target="_blank" rel="noopener" class="btn btn-light text-poirot-blue fw-bold px-4">
                <i class="fa-brands fa-whatsapp ms-1 text-success"></i> إرسال إشعار شام كاش عبر واتساب
            </a>
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Cases" asp-action="Index" class="btn btn-poirot-blue px-4">
                تصفح المزيد من القضايا
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-poirot-outline px-4">
                العودة للرئيسية
            </a>
        </div>
    </div>
</section>